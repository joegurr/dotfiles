#!/usr/bin/env bash
#
# Sweep the clutter folders into ~/Archive/<today>/<path relative to $HOME>/.
#
# Runs at login via ~/Library/LaunchAgents/com.joegurr.mac-archive.plist, and
# no-ops once it has run today, so rebooting three times does not sweep three
# times -- and files put on the Desktop after the morning sweep stay put until
# tomorrow.

set -euo pipefail

archive_root="$HOME/Archive"
state_file="$HOME/.local/state/mac-archive/last-run"
today="$(date +%Y-%m-%d)"

if [[ -r "$state_file" && "$(cat "$state_file")" == "$today" ]]; then
    exit 0
fi

sources=("$HOME/Desktop" "$HOME/Downloads")

# Picked up rather than hardcoded so new worktrees are swept without editing
# this list. Depth 5 reaches agent worktrees
# (~/code/<repo>/.claude/worktrees/<name>), which the worktree removal below
# would otherwise delete along with their drafts.
while IFS= read -r drafts_dir; do
    sources+=("$drafts_dir")
done < <(find "$HOME/code" -maxdepth 5 -type d -name '.drafts' 2>/dev/null | sort)

moved=0
skipped=0
blocked=0

for source in "${sources[@]}"; do
    [[ -d "$source" ]] || continue

    # Desktop and Downloads are TCC-protected, and a launchd-spawned bash is
    # not the same responsible process as your terminal. The glob below turns
    # the resulting EPERM into an empty list, so without this check a blocked
    # sweep looks exactly like a clean one.
    if ! ls -A "$source" >/dev/null 2>&1; then
        printf 'cannot read %s -- grant Full Disk Access, then it will retry\n' \
            "$source" >&2
        blocked=$((blocked + 1))
        continue
    fi

    destination="$archive_root/$today/${source#"$HOME"/}"

    shopt -s dotglob nullglob
    entries=("$source"/*)
    shopt -u dotglob nullglob

    # launchd runs this under /bin/bash 3.2, where expanding an empty array
    # with set -u is a fatal error rather than an empty list.
    ((${#entries[@]})) || continue

    for entry in "${entries[@]}"; do
        name="$(basename "$entry")"

        case "$name" in
            # Moving a download in flight breaks it, and the Finder metadata
            # files just come back.
            *.crdownload | *.part | *.partial | *.download | .DS_Store | .localized)
                skipped=$((skipped + 1))
                continue
                ;;
        esac

        mkdir -p "$destination"

        # Two folders can hold the same filename, and a same-day second sweep
        # can collide with the first.
        target="$destination/$name"
        attempt=2
        while [[ -e "$target" ]]; do
            target="$destination/$name ($attempt)"
            attempt=$((attempt + 1))
        done

        if mv "$entry" "$target"; then
            moved=$((moved + 1))
        else
            # A locked or in-use file should not abort the whole sweep.
            skipped=$((skipped + 1))
        fi
    done
done

# Remove git worktrees whose work has landed. After the sweep, so their
# .drafts are already archived. Branches are kept, so
# `git worktree add <path> <branch>` brings one back.
removed=0
while IFS= read -r git_dir; do
    repo="$(dirname "$git_dir")"

    # launchd's PATH has no Homebrew. gh is what tells a squash-merged branch
    # from one still in review; a repo it cannot read is left alone.
    prs="$(cd "$repo" && /opt/homebrew/bin/gh pr list --state all --limit 1000 \
        --json headRefName,state --jq '.[] | "\(.state) \(.headRefName)"' 2>/dev/null)" || continue

    while IFS=$'\t' read -r path branch; do
        if [[ "$path" == "$repo" ]]; then
            continue
        fi

        # Detached: no branch to judge it by.
        if [[ -z "$branch" ]]; then
            continue
        fi

        if grep -qxF "OPEN $branch" <<<"$prs"; then
            continue
        fi

        # Landed: its PR was merged or closed, or it has nothing main lacks.
        landed=0
        if grep -qxF -e "MERGED $branch" -e "CLOSED $branch" <<<"$prs"; then
            landed=1
        fi
        if git -C "$repo" merge-base --is-ancestor "$branch" origin/main 2>/dev/null; then
            landed=1
        fi
        if ((landed == 0)); then
            continue
        fi

        # Uncommitted work keeps it. sst-env.d.ts is regenerated by every sst
        # command and the deploy logs are throwaway.
        dirt="$(git -C "$path" status --porcelain 2>/dev/null |
            grep -v -e '^ M sst-env\.d\.ts$' -e '^?? \.deploy-.*\.log$' || true)"
        if [[ -n "$dirt" ]]; then
            continue
        fi

        if git -C "$repo" worktree remove --force "$path"; then
            printf 'removed worktree %s (%s)\n' "$path" "$branch"
            removed=$((removed + 1))
        fi
    done < <(git -C "$repo" worktree list --porcelain | awk '
        /^worktree / { path = substr($0, 10); branch = "" }
        /^branch /   { branch = substr($0, 8); sub("^refs/heads/", "", branch) }
        /^$/         { print path "\t" branch }')
done < <(find "$HOME/code" -mindepth 2 -maxdepth 2 -type d -name '.git' 2>/dev/null | sort)

# Deliberately not recorded as a run: leaving the stamp unset means the next
# login retries instead of declaring the day done on a partial sweep.
if ((blocked > 0)); then
    printf '%s: moved %d, skipped %d, BLOCKED %d\n' \
        "$today" "$moved" "$skipped" "$blocked"
    exit 1
fi

mkdir -p "$(dirname "$state_file")"
printf '%s\n' "$today" >"$state_file"

printf '%s: moved %d, skipped %d, removed %d worktrees\n' \
    "$today" "$moved" "$skipped" "$removed"

if ((moved > 0)); then
    osascript -e "display notification \"Moved $moved items into ~/Archive/$today\" with title \"Mac Archive\"" || true
fi
