#!/usr/bin/python3

import os
import json

VIM_SPELL_FILEPATH = os.getenv("VIM_SPELL_FILEPATH")
VSCODE_SETTINGS_FILEPATH = os.getenv("VSCODE_SETTINGS_FILEPATH")

newline_file = VIM_SPELL_FILEPATH
json_file = VSCODE_SETTINGS_FILEPATH


def read_newline_delimited_file(file_path):
    with open(file_path, "r") as file:
        words = [word.strip() for word in file.readlines()]
    return set(words)


def read_json_file(file_path):
    with open(file_path, "r") as file:
        data = json.load(file)
    return data


def write_newline_file(file_path, words):
    with open(file_path, "w") as file:
        file.write("\n".join(words) + "\n")


def write_json_file(file_path, data):
    with open(file_path, "w") as file:
        json.dump(data, file, indent=2)


newline_words = read_newline_delimited_file(newline_file)

if json_file:
    json_data = read_json_file(json_file)
    json_words = json_data["cSpell.userWords"]
    union_words = sorted(newline_words.union(json_words))
    json_data["cSpell.userWords"] = list(union_words)
    write_json_file(json_file, json_data)
else:
    union_words = sorted(newline_words)

write_newline_file(newline_file, union_words)
