#!/bin/sh
# Back up the irreplaceable stuff (Documents) to every
# reachable borg repo. Local repos whose drive isn't mounted are skipped.
#
# Usage: ,backup [repo ...]
# Env:   BACKUP_REPOS      space separated, overrides the defaults
#        BORG_PASSCOMMAND  optional, otherwise borg asks for the passphrase

set -u

[ $# -gt 0 ] || set -- ${BACKUP_REPOS:-/media/$USER/BANACH/NOETHER-borg /media/$USER/HILBERT/NOETHER-borg ssh://riesz:23/./NOETHER-borg}

cd "$HOME" || exit 1
status=0
for repo in "$@"; do
    case $repo in
        /*) [ -d "$repo" ] || { echo "skip $repo (not mounted)"; continue; } ;;
    esac
    echo "== $repo"
    borg create --stats --compression zstd --exclude-caches \
        "$repo::{hostname}-{now}" Documents || status=1
    borg prune --glob-archives '{hostname}-*' \
        --keep-daily 7 --keep-weekly 4 --keep-monthly 12 "$repo" || status=1
    borg compact "$repo" || status=1
done
exit $status
