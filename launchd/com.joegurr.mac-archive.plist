<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.joegurr.mac-archive</string>

    <!-- launchd does not expand ~, so these paths are absolute and assume the
         login name is joegurr.

         /bin/bash is named explicitly rather than letting the script's
         "#!/usr/bin/env bash" shebang pick it: TCC attributes Full Disk Access
         to the exec'd binary, which under a shebang is /usr/bin/env, not bash.
         Granting access to /bin/bash only takes effect if /bin/bash is what
         launchd actually execs. It also pins the interpreter, instead of
         resolving it against launchd's minimal PATH. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/joegurr/.local/bin/mac-archive</string>
    </array>

    <!-- At login. The script's own once-a-day guard stops repeated reboots
         from sweeping repeatedly. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/joegurr/Library/Logs/mac-archive.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/joegurr/Library/Logs/mac-archive.log</string>
</dict>
</plist>
