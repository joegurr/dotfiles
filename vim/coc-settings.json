{
    "languageserver": {
        "pyright": {
            "command": "pyright-langserver",
            "args": [
                "--stdio"
            ],
            "filetypes": [
                "python"
            ],
            "trace.server": "verbose",
            "settings": {}
        },
        "latex": {
            "command": "texlab",
            "filetypes": [
                "tex",
                "latex",
                "bib",
                "sty"
            ]
        }
    },
    "suggest": {
        "triggerCompletionWait": 1000
    }
}
