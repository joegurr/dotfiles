{
  "extends": [
    "@commitlint/config-conventional"
  ],
  "rules": {
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "chore",
        "build",
        "ci",
        "config",
        "notes",
        "revert",
        "typo"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "config",
        "dependencies",
        "build",
        "tests",
        "api"
      ]
    ]
  }
}

