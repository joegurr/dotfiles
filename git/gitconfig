[user]
	name = Joe Gurr
	email = me@joegurr.com
	signingkey = /home/joe/.ssh/id_me-at-joegurr-dot-com.pub

[init]
	defaultBranch = main

[pull]
	ff = only

[core]
	excludesfile = /home/joe/.gitignore
	attributesfile = /home/joe/.gitattributes
	editor = vim
	pager = delta

[filter "nb-clean"]
	clean = uvx nb-clean clean
	smudge = cat
	required = true

[gpg]
	format = ssh

[commit]
	gpgsign = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side=true
	pager=batcat -pp

[merge]
	conflictStyle = diff3

[credential]
	helper = store

[url "git@github.com:"]
	insteadOf = https://github.com/

[alias]
# https://arialdomartini.github.io/git-fixup
	fixup = "!f() { TARGET=$(git rev-parse $1); git commit --fixup=$TARGET ${@:2} && GIT_SEQUENCE_EDITOR=true git rebase -i --autostash --autosquash $TARGET^; }; f"
