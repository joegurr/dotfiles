[user]
	name = Joe Gurr
	email = me@joegurr.com
	signingkey = /home/joe/.ssh/id_me-at-joegurr-dot-com.pub

[init]
	defaultBranch = main
	templateDir = ~/.git-templates

[pull]
	ff = only

[core]
	excludesfile = /home/joe/.gitignore
	attributesfile = /home/joe/.gitattributes
	editor = vim
	pager = delta

[filter "nb-clean"]
	clean = /home/joe/code/.venv/bin/nb-clean clean
	smudge = cat
	required = true

[gpg]
	format = ssh

[commit]
	gpgsign = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side=true

[merge]
	conflictStyle = diff3

[credential]
	helper = store

